 {
  "simulant_id": "S018",
  "field": "release_date",
  "outcome": "flagged: verifier could not confirm",
  "needs_review": true,
  "problems": [
   "The quote exists verbatim (p.7: 'Received: 30 January 2019; Accepted: 19 February 2020;') and the header reads '(2020) 10:5473', but this is the paper's publication, not a simulant release date; calling the value 'supported' overstates it. The paper itself shows earlier availability: p.6 'Currently, EAC-1A is already taken in use for small-scale, low-TRL experiments undertaken by ESA', ref 36 is Nieke et al. 2019 'Manufacturing Dense Thick Films of Lunar Regolith Simulant EAC-1', and Manick et al. 2018 (papers/Manick_etal_2018_LPSC49_abstract_1411\u2026) lists 'EAC-1 Basanite ESA04-A 17DE01, 17DE02, 17DE03' batches (verified) \u2014 for EAC-1, not EAC-1A. No document states when EAC-1A was first released."
  ]
 },
